# Porta de acesso à aplicação no NAS
APP_PORT=61100

# Chave secreta para JWT — muda para um valor aleatório longo em produção
SECRET_KEY=muda-esta-chave-para-algo-secreto-e-longo

# Password do admin criado automaticamente no primeiro arranque
ADMIN_PASSWORD=admin123

# Duração da sessão em minutos (padrão: 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480
